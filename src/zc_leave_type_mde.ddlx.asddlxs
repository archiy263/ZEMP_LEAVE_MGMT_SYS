@Metadata.layer: #CORE

annotate entity ZC_LEAVE_TYPE_pv with
{
  @UI.facet: [
    {
      id: 'LeaveTypeInfo',
      type: #IDENTIFICATION_REFERENCE,
      label: 'Leave Type Information'
    }
  ]

  @UI.identification: [{ position: 10 }]
  LeaveTypeID;

  @UI.identification: [{ position: 20 }]
  @EndUserText.label: 'Leave Type'
@UI.lineItem: [
  {
    position        : 20,
    importance      : #HIGH,
    label           : 'Leave Type',
    cssDefault.width: '12rem'
  }
]
  LeaveName;

  @UI.identification: [{ position: 30 }]
  @EndUserText.label: 'Max Days'
@UI.lineItem: [
  {
    position        : 30,
    importance      : #HIGH,
    label           : 'Max Days',
    cssDefault.width: '7rem'
  }
]
  MaxDays;
}