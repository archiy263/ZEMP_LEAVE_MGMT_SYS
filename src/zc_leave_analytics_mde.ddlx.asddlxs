@Metadata.layer: #CORE

@UI.selectionVariant: [{
    qualifier: 'AnalyticsSV',
    text: 'Leave Analytics'
}]
@UI.presentationVariant: [{
    qualifier: 'AnalyticsPV',
    text: 'Leave Analytics',
    visualizations: [
        { type: #AS_CHART, qualifier: 'LeaveStatusByEmployee' },
        { type: #AS_LINEITEM }
    ]
}]

@UI.selectionPresentationVariant: [{
    presentationVariantQualifier: 'AnalyticsPV',
    selectionVariantQualifier: 'AnalyticsSV'
}]

@UI.chart: [{
    qualifier: 'LeaveStatusByEmployee',
    title: 'Leave Request Status',
    description: 'Approved, pending and rejected leave requests',
    chartType: #BAR_STACKED,
    dimensions: [ 'EmployeeName' ],
    measures: [
        'ApprovedLeaveCount',
        'PendingLeaveCount',
        'RejectedLeaveCount'
    ],
    measureAttributes: [
        { measure: 'ApprovedLeaveCount', role: #AXIS_1 },
        { measure: 'PendingLeaveCount', role: #AXIS_1 },
        { measure: 'RejectedLeaveCount', role: #AXIS_1 }
    ]
}]

annotate entity ZC_LEAVE_ANALYTICS with
{
@UI.facet: [
    {
        id: 'EmployeeInformation',
        type: #IDENTIFICATION_REFERENCE,
        label: 'Employee Information',
        position: 10
    },
    {
    id: 'RequestStatusChart',
    purpose: #STANDARD,
    type: #CHART_REFERENCE,
    targetQualifier: 'LeaveStatusByEmployee',
    label: 'Leave Request Statistics',
    position: 20
}
    
]

    @EndUserText.label: 'Manager ID'
    @UI.selectionField: [{ position: 10 }]
    @UI.lineItem: [{ position: 10 }]
    @UI.identification: [{ position: 10 }]
    ManagerID;

    @EndUserText.label: 'Employee ID'
    @UI.lineItem: [{ position: 20 }]
    @UI.identification: [{ position: 20 }]
    EmployeeID;

    @EndUserText.label: 'Employee'
    @UI.lineItem: [{ position: 30 }]
    @UI.identification: [{ position: 30 }]
    EmployeeName;

    @EndUserText.label: 'Department'
    @UI.lineItem: [{ position: 40 }]
    @UI.identification: [{ position: 40 }]
    Department;

    @EndUserText.label: 'Joining Date'
    @UI.lineItem: [{ position: 50 }]
    @UI.identification: [{ position: 50 }]
    JoiningDate;

    @EndUserText.label: 'Leave Balance'
    @UI.lineItem: [{ position: 60 }]
    @UI.identification: [{ position: 60 }]
    LeaveBalance;

    @EndUserText.label: 'Total Requests'
    @UI.lineItem: [{ position: 70 }]
    @UI.identification: [{ position: 70 }]
    TotalLeaveRequests;

    @EndUserText.label: 'Pending Requests'
    @UI.lineItem: [{ position: 80 }]
    @UI.identification: [{ position: 80 }]
    
    PendingLeaveCount;

    @EndUserText.label: 'Approved Requests'
    @UI.lineItem: [{ position: 90 }]
    @UI.identification: [{ position: 90 }]
    ApprovedLeaveCount;

    @EndUserText.label: 'Rejected Requests'
    @UI.lineItem: [{ position: 100 }]
    @UI.identification: [{ position: 100 }]
    RejectedLeaveCount;
}