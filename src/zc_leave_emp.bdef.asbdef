projection;
strict ( 2 );
use draft;

define behavior for ZC_LEAVE_EMP alias Leave
{
  use create;
  use update;
  use delete;

  field ( readonly ) StatusID;
  field ( readonly ) LeaveUUID;
  field ( readonly ) LeaveNumber;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}